) <fig:ch3_ic_1>

#figure(
  image("images/ch3_ic_3.png", width: 85%),
  caption: [Регулятор по состоянию (нормальный), x0 = (0, 0, 0.2, 0)]
) <fig:ch3_ic_3>

#figure(
  image("images/ch3_ic_5.png", width: 85%),
